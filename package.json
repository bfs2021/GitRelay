{
  "name": "git-relay",
  "version": "0.1.0",
  "description": "GitRelay: shared Git worktree change awareness for coding agents",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "git",
    "worktree",
    "coding-agent"
  ],
  "files": [
    "src",
    "vendor",
    "dist",
    "scripts",
    "skills",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    ".codex-plugin",
    "assets"
  ],
  "bin": {
    "git-relay": "./dist/cli/main.js",
    "worktree-relay": "./dist/cli/main.js",
    "worktree-sync": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.2"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run format:check && npm run typecheck && npm run check:release && npm test && npm pack --dry-run",
    "build": "node scripts/build.mjs",
    "build:codex-plugin": "npm run build && node scripts/build-codex-plugin.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/core/*.test.ts tests/adapters/*.test.ts tests/cli/*.test.*"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.2",
    "@types/node": "22.19.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
